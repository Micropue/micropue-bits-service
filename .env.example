# ==================== MySQL ====================
# 本机运行的后端用 127.0.0.1；容器间互访用服务名 mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3311
MYSQL_DATABASE=bits
MYSQL_USER=bits
MYSQL_PASSWORD=bits
MYSQL_ROOT_PASSWORD=root

# ==================== Redis ====================
# 本机运行的后端用 127.0.0.1；容器间互访用服务名 redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6479

# ==================== SMTP（腾讯企业邮） ====================
SMTP_HOST=smtp.exmail.qq.com
# 465 = SSL 直连（secure=true），587 = STARTTLS（secure=false）
SMTP_PORT=465
SMTP_SECURE=true
# 完整邮箱地址，如 noreply@micropue.com.cn
SMTP_USER=
# 邮箱登录密码或客户端专用密码
SMTP_PASSWORD=
# 发件人，如 BITS <noreply@micropue.com.cn>
SMTP_FROM=

# ==================== JWT ====================
# 登录会话签名密钥（随机长字符串，如 openssl rand -hex 32；生产环境务必保密且不与开发环境共用）
JWT_SECRET=

# PrimeUI 许可证 key（免费社区版，仅 PrimeVue v5 读取，当前 v4 未使用，保留备用）
NUXT_PUBLIC_PRIMEUI_LICENSE=

# ==================== hCaptcha ====================
# 前端 sitekey（hCaptcha 控制台获取，公开）
HCAPTCHA_SITEKEY=
# 后端校验密钥 secret（与 sitekey 同一控制台获取，务必保密）
HCAPTCHA_SECRET=

# ==================== GitHub OAuth ====================
# GitHub OAuth App 凭据（Settings > Developer settings > OAuth Apps）
# Client ID（公开）
GITHUB_CLIENT_ID=
# Client Secret（保密）
GITHUB_CLIENT_SECRET=
# 回调地址：留空则按请求来源自动推导为 <origin>/api/auth/github/callback（须与 GitHub OAuth App 登记的完全一致）
GITHUB_REDIRECT_URI=

# ==================== WebAuthn (Passkey) ====================
# 均可留空自动推导：RP ID 默认取请求 hostname，Origin 默认取请求 origin
WEBAUTHN_RP_NAME=MICROPUE BITS
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGIN=

# ==================== Authenticator App (TOTP) ====================
# AuthApp 密钥的静态加密密钥（AES-256-GCM），32 字节，base64 或 64 位 hex；务必保密且生产/开发不共用
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOTP_ENC_KEY=
# 验证器中显示的发行方名称
TOTP_ISSUER=BITS

# ==================== 运行模式 ====================
# dev = 开发模式（跳过 hCaptcha 人机校验，允许本地无域名调试）；其它值 = 正常模式
# 说明：前端按构建期读取，改动后需重启；若前端未生效，删除 .nuxt 后重启
MODE=prod
