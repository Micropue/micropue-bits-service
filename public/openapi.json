            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Dependency"
            }
          },
          "forkFromSid": {
            "type": ["string", "null"]
          },
          "favoriteCount": {
            "type": "integer",
            "minimum": 0
          },
          "copyCount": {
            "type": "integer",
            "minimum": 0
          },
          "forkCount": {
            "type": "integer",
            "minimum": 0
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
