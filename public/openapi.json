          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "maxLength": 40
          },
          "language": {
            "type": "string",
            "description": "Language slug from the public language catalog."
          },
          "visibility": {
            "$ref": "#/components/schemas/Visibility"
          },
          "tags": {
            "type": "array",
            "maxItems": 5,
