      "CreateSnippetRequest": {
        "type": "object",
        "required": ["name", "language", "code"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "intro": {
            "type": "string",
            "maxLength": 500,
            "default": ""
