{
  "openapi": "3.1.0",
  "info": {
    "title": "BITS Open API",
    "version": "1.0.0",
    "summary": "Manage your own BITS snippets and groups with an API Key.",
    "description": "The BITS Open API is a versioned, API-key-authenticated interface for managing the content owned by the key's account. It can read, create, update and soft-delete snippets, and read, create, update and delete groups. It cannot change account profile, email, password, two-factor authentication, Passkeys, followers, favorites, OAuth grants or other security settings.\n\nSend the key as `Authorization: Bearer bits_sk_YOUR_KEY` or `X-API-Key: bits_sk_YOUR_KEY`. Site cookies and OAuth access tokens are not accepted. Read requests are limited to 120 per minute per key and write requests to 30 per minute per key. Rate limiting fails closed when the rate-limit store is unavailable.",
    "contact": {
      "name": "BITS",
      "url": "https://bits.micropue.com.cn/docs/developer/api-keys"
    }
  },
  "servers": [
    {
      "url": "https://bits.micropue.com.cn",
      "description": "Production"
    }
  ],
  "externalDocs": {
    "description": "BITS developer documentation",
    "url": "https://bits.micropue.com.cn/docs/developer/open-api"
  },
  "security": [
    {
      "bearerAuth": []
    },
    {
      "apiKeyAuth": []
    }
  ],
  "tags": [
    {
      "name": "Account",
      "description": "Identity and permission information for the current API key"
    },
    {
      "name": "Snippets",
      "description": "Create and manage snippets owned by the API key's account"
    },
    {
      "name": "Groups",
      "description": "Create and manage groups owned by the API key's account"
    }
  ],
  "paths": {
    "/api/v1/me": {
      "get": {
        "tags": ["Account"],
        "summary": "Get the current API identity",
        "description": "Returns the account, application and API key represented by the supplied key. Requires `content:read`.",
        "operationId": "getCurrentIdentity",
        "responses": {
          "200": {
            "description": "Current identity and key metadata",
            "headers": {
              "X-RateLimit-Limit": {
                "$ref": "#/components/headers/X-RateLimit-Limit"
              },
              "X-RateLimit-Remaining": {
                "$ref": "#/components/headers/X-RateLimit-Remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/api/v1/snippets": {
      "get": {
        "tags": ["Snippets"],
        "summary": "List your snippets",
        "description": "Lists non-deleted snippets owned by the API key's account, including private and unlisted snippets. Requires `content:read`.",
        "operationId": "listSnippets",
        "parameters": [
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "$ref": "#/components/parameters/Offset"
          },
          {
            "$ref": "#/components/parameters/Search"
          },
          {
            "$ref": "#/components/parameters/Visibility"
          }
        ],
        "responses": {
          "200": {
            "description": "A page of snippets",
            "headers": {
              "X-RateLimit-Limit": {
                "$ref": "#/components/headers/X-RateLimit-Limit"
              },
              "X-RateLimit-Remaining": {
                "$ref": "#/components/headers/X-RateLimit-Remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SnippetListResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      },
      "post": {
        "tags": ["Snippets"],
        "summary": "Create a snippet",
        "description": "Creates a snippet owned by the API key's account. Requires `content:create`. If `slug` is omitted, a URL name is generated from the name; a numeric suffix is added when needed. Public and unlisted content require the account to have a username set.",
        "operationId": "createSnippet",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSnippetRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Snippet created",
            "headers": {
              "X-RateLimit-Limit": {
                "$ref": "#/components/headers/X-RateLimit-Limit"
              },
              "X-RateLimit-Remaining": {
                "$ref": "#/components/headers/X-RateLimit-Remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SnippetWriteResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/api/v1/snippets/{slug}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/SnippetSlug"
        }
      ],
      "get": {
        "tags": ["Snippets"],
        "summary": "Get one of your snippets",
        "description": "Returns a snippet owned by the API key's account, including its code body. Requires `content:read`.",
        "operationId": "getSnippet",
        "responses": {
          "200": {
            "description": "Snippet detail",
            "headers": {
              "X-RateLimit-Limit": {
                "$ref": "#/components/headers/X-RateLimit-Limit"
              },
              "X-RateLimit-Remaining": {
                "$ref": "#/components/headers/X-RateLimit-Remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SnippetResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      },
      "patch": {
        "tags": ["Snippets"],
        "summary": "Update or rename a snippet",
        "description": "Partially updates a snippet owned by the API key's account. Omitted fields keep their current values. Sending `slug` renames the URL name; the old public URL redirects to the new one. Requires `content:update`.",
        "operationId": "updateSnippet",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateSnippetRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated snippet",
            "headers": {
              "X-RateLimit-Limit": {
                "$ref": "#/components/headers/X-RateLimit-Limit"
              },
              "X-RateLimit-Remaining": {
                "$ref": "#/components/headers/X-RateLimit-Remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SnippetWriteResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      },
      "delete": {
        "tags": ["Snippets"],
        "summary": "Soft-delete a snippet",
        "description": "Soft-deletes a snippet owned by the API key's account. Requires `content:delete`.",
        "operationId": "deleteSnippet",
        "responses": {
          "200": {
            "description": "Snippet deleted",
            "headers": {
              "X-RateLimit-Limit": {
                "$ref": "#/components/headers/X-RateLimit-Limit"
              },
              "X-RateLimit-Remaining": {
                "$ref": "#/components/headers/X-RateLimit-Remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeleteResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/api/v1/groups": {
      "get": {
        "tags": ["Groups"],
        "summary": "List your groups",
        "description": "Lists non-deleted groups owned by the API key's account. Requires `content:read`.",
        "operationId": "listGroups",
        "parameters": [
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "$ref": "#/components/parameters/Offset"
          },
          {
            "$ref": "#/components/parameters/Search"
          },
          {
            "$ref": "#/components/parameters/Visibility"
          }
        ],
        "responses": {
          "200": {
            "description": "A page of groups",
            "headers": {
              "X-RateLimit-Limit": {
                "$ref": "#/components/headers/X-RateLimit-Limit"
              },
              "X-RateLimit-Remaining": {
                "$ref": "#/components/headers/X-RateLimit-Remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GroupListResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      },
      "post": {
        "tags": ["Groups"],
        "summary": "Create a group",
        "description": "Creates a group owned by the API key's account. Requires `content:create`. If `slug` is omitted, a URL name is generated from the name; a numeric suffix is added when needed. Public and unlisted content require the account to have a username set.",
        "operationId": "createGroup",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateGroupRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Group created",
            "headers": {
              "X-RateLimit-Limit": {
                "$ref": "#/components/headers/X-RateLimit-Limit"
              },
              "X-RateLimit-Remaining": {
                "$ref": "#/components/headers/X-RateLimit-Remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GroupWriteResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/api/v1/groups/{slug}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/GroupSlug"
        }
      ],
      "get": {
        "tags": ["Groups"],
        "summary": "Get one of your groups",
        "description": "Returns a group owned by the API key's account. Requires `content:read`.",
        "operationId": "getGroup",
        "responses": {
          "200": {
            "description": "Group detail",
            "headers": {
              "X-RateLimit-Limit": {
                "$ref": "#/components/headers/X-RateLimit-Limit"
              },
              "X-RateLimit-Remaining": {
                "$ref": "#/components/headers/X-RateLimit-Remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GroupResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      },
      "patch": {
        "tags": ["Groups"],
        "summary": "Update or rename a group",
        "description": "Partially updates a group owned by the API key's account. Omitted fields keep their current values. Sending `slug` renames the URL name; the old public URL redirects to the new one. Requires `content:update`.",
        "operationId": "updateGroup",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateGroupRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated group",
            "headers": {
              "X-RateLimit-Limit": {
                "$ref": "#/components/headers/X-RateLimit-Limit"
              },
              "X-RateLimit-Remaining": {
                "$ref": "#/components/headers/X-RateLimit-Remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GroupWriteResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      },
      "delete": {
        "tags": ["Groups"],
        "summary": "Delete a group",
        "description": "Deletes a group owned by the API key's account. Snippets inside the group are kept and lose their group association. Requires `content:delete`.",
        "operationId": "deleteGroup",
        "responses": {
          "200": {
            "description": "Group deleted",
            "headers": {
              "X-RateLimit-Limit": {
                "$ref": "#/components/headers/X-RateLimit-Limit"
              },
              "X-RateLimit-Remaining": {
                "$ref": "#/components/headers/X-RateLimit-Remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeleteResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Send the full API key as a Bearer token."
      },
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "Send the full API key in the X-API-Key header."
      }
    },
    "parameters": {
      "Limit": {
        "name": "limit",
        "in": "query",
        "description": "Maximum records to return. Defaults to 20.",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "default": 20
        }
      },
      "Offset": {
        "name": "offset",
        "in": "query",
        "description": "Number of records to skip. Defaults to 0.",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        }
      },
      "Search": {
        "name": "q",
        "in": "query",
        "description": "Case-insensitive search over name and intro. Maximum 200 characters.",
        "required": false,
        "schema": {
          "type": "string",
          "maxLength": 200
        }
      },
      "Visibility": {
        "name": "visibility",
        "in": "query",
        "description": "Return only content with this visibility.",
        "required": false,
        "schema": {
          "$ref": "#/components/schemas/Visibility"
        }
      },
      "SnippetSlug": {
        "name": "slug",
        "in": "path",
        "description": "The snippet's URL name.",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 40
        }
      },
      "GroupSlug": {
        "name": "slug",
        "in": "path",
        "description": "The group's URL name.",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 40
        }
      }
    },
    "headers": {
      "X-RateLimit-Limit": {
        "description": "Request limit for the current read or write bucket.",
        "schema": {
          "type": "integer"
        }
      },
      "X-RateLimit-Remaining": {
        "description": "Requests remaining in the current window.",
        "schema": {
          "type": "integer"
        }
      },
      "Retry-After": {
        "description": "Seconds until the rate-limit window resets.",
        "schema": {
          "type": "integer"
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid field, malformed JSON or unsupported visibility.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "statusCode": 400,
              "statusMessage": "Code is too large (max 1 MB)",
              "data": {
                "field": "code"
              }
            }
          }
        }
      },
      "Unauthorized": {
        "description": "API key is missing, malformed, invalid, expired or revoked.",
        "headers": {
          "WWW-Authenticate": {
            "description": "Bearer challenge for API key authentication.",
            "schema": {
              "type": "string"
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "statusCode": 401,
              "statusMessage": "The API key is invalid or has expired",
              "data": {
                "code": "API_KEY_INVALID"
              }
            }
          }
        }
      },
      "Forbidden": {
        "description": "The key lacks the required permission, the application is suspended or the account is disabled.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "statusCode": 403,
              "statusMessage": "This API key does not have the content:update permission",
              "data": {
                "code": "API_KEY_PERMISSION_REQUIRED",
                "requiredPermission": "content:update"
              }
            }
          }
        }
      },
      "NotFound": {
        "description": "The requested content does not exist in the key owner's account.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "statusCode": 404,
              "statusMessage": "Snippet not found"
            }
          }
        }
      },
      "Conflict": {
        "description": "The requested URL name is already used by another content item or alias.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "statusCode": 409,
              "statusMessage": "This URL is already taken",
              "data": {
                "field": "slug"
              }
            }
          }
        }
      },
      "TooManyRequests": {
        "description": "The read or write rate limit was exceeded.",
        "headers": {
          "Retry-After": {
            "$ref": "#/components/headers/Retry-After"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "statusCode": 429,
              "statusMessage": "API read rate limit exceeded (120 requests per minute)",
              "data": {
                "retryAfterSeconds": 42
              }
            }
          }
        }
      }
    },
    "schemas": {
      "Visibility": {
        "type": "string",
        "enum": ["public", "unlisted", "private"]
      },
      "Permission": {
        "type": "string",
        "enum": ["content:read", "content:create", "content:update", "content:delete"]
      },
      "Tag": {
        "type": "object",
        "required": ["key", "name"],
        "properties": {
          "key": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "Language": {
        "type": "object",
        "required": ["slug", "name", "logoUrl"],
        "properties": {
          "slug": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "logoUrl": {
            "type": ["string", "null"]
          }
        }
      },
      "Dependency": {
        "type": "object",
        "required": ["slug", "name", "kind"],
        "properties": {
          "slug": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": ["framework", "library", "tool", "runtime"]
          }
        }
      },
      "GroupReference": {
        "type": "object",
        "required": ["slug", "name"],
        "properties": {
          "slug": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "Snippet": {
        "type": "object",
        "required": [
          "sid",
          "slug",
          "name",
          "intro",
          "visibility",
          "code",
          "language",
          "group",
          "tags",
          "dependencies",
          "forkFromSid",
          "favoriteCount",
          "copyCount",
          "forkCount",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "sid": {
            "type": "string",
            "description": "Stable internal identifier."
          },
          "slug": {
            "type": "string",
            "maxLength": 40
          },
          "name": {
            "type": "string",
            "maxLength": 60
          },
          "intro": {
            "type": "string",
            "maxLength": 500
          },
          "visibility": {
            "$ref": "#/components/schemas/Visibility"
          },
          "code": {
            "type": "string",
            "description": "Code body, at most 1,048,576 UTF-8 bytes."
          },
          "language": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Language"
              },
              {
                "type": "null"
              }
            ]
          },
